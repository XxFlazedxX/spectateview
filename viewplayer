-- Anti Grapple persistent function
local hookHitboxes = {}
local hbConn = nil
local TELEPORT_DISTANCE = 10
local SHOW_RADIUS = 60
local HITBOX_SIZE = Vector3.new(4, 4, 130)
local HITBOX_OFFSET = CFrame.new(0, 0, -75)
local VISIBLE_ALPHA = 0.2

local function createHitbox(hook)
	local hitbox = Instance.new("Part")
	hitbox.Size = HITBOX_SIZE
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.Transparency = 0.8
	hitbox.Material = Enum.Material.ForceField
	hitbox.Color = colors.accent
	hitbox.Name = "LocalGrappleHitbox"
	hitbox.Parent = Workspace
	hookHitboxes[hook] = hitbox
end

local function removeHitbox(hook)
	if hookHitboxes[hook] then hookHitboxes[hook]:Destroy() end
	hookHitboxes[hook] = nil
end

local function updateHitboxes()
	local ropesFolder = Workspace:FindFirstChild("Ropes")
	local existingHooks = {}
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	
	if ropesFolder and ropesFolder:IsA("Folder") then
		for _, playerFolder in pairs(ropesFolder:GetChildren()) do
			if playerFolder:IsA("Folder") and playerFolder.Name ~= LP.Name then
				for _, hook in pairs(playerFolder:GetChildren()) do
					if hook:IsA("BasePart") and hook.Name == "Hook" then
						existingHooks[hook] = true
						if not hookHitboxes[hook] then createHitbox(hook) end
						local hb = hookHitboxes[hook]
						hb.CFrame = hook.CFrame * HITBOX_OFFSET
						if hrp then
							local dist = (hook.Position - hrp.Position).Magnitude
							hb.Transparency = (dist <= SHOW_RADIUS) and (1 - VISIBLE_ALPHA) or 1
						else
							hb.Transparency = 1
						end
					end
				end
			end
		end
	end
	
	for hook in pairs(hookHitboxes) do
		if not existingHooks[hook] or not hook.Parent then
			removeHitbox(hook)
		end
	end
end

local function isPointInPart(part, point)
	local relative = part.CFrame:PointToObjectSpace(point)
	local size = part.Size / 2
	return math.abs(relative.X) <= size.X and math.abs(relative.Y) <= size.Y and math.abs(relative.Z) <= size.Z
end

local function isSafePosition(position)
	for _, hitbox in pairs(hookHitboxes) do
		if isPointInPart(hitbox, position) then return false end
	end
	return true
end

local function groundSnap(pos)
	local result = Workspace:Raycast(pos + Vector3.new(0, 50, 0), Vector3.new(0, -200, 0))
	return result and (result.Position + Vector3.new(0, 3, 0)) or (pos + Vector3.new(0, 3, 0))
end

local function getSafeTeleportPosition(currentPosition)
	for _ = 1, 10 do
		local angle = math.random() * 2 * math.pi
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
		local offset = direction * TELEPORT_DISTANCE
		local newPos = currentPosition + offset
		if isSafePosition(newPos) then
			return groundSnap(newPos)
		end
	end
	return currentPosition
end

local function heartbeat()
	local character = LP.Character
	if not character then return end
	updateHitboxes()
	
	for _, limb in pairs(character:GetChildren()) do
		if limb:IsA("BasePart") then
			for _, hitbox in pairs(hookHitboxes) do
				if isPointInPart(hitbox, limb.Position) then
					local newPos = getSafeTeleportPosition(limb.Position)
					if newPos ~= limb.Position then
						limb.AssemblyLinearVelocity = Vector3.zero
						character:MoveTo(newPos)
					end
					return
				end
			end
		end
	end
end

local function startAntiGrapple()
	if hbConn then
		hbConn:Disconnect()
		hbConn = nil
	end
	hbConn = RunService.Heartbeat:Connect(heartbeat)
end

local function stopAntiGrapple()
	if hbConn then
		hbConn:Disconnect()
		hbConn = nil
	end
	for _, hb in pairs(hookHitboxes) do
		if hb then
			hb:Destroy()
		end
	end
	hookHitboxes = {}
end

